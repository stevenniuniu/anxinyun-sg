---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
			<header class="site-header">
				<a class="brand" href="#top" aria-label="安心运 Anxinyun home"><span class="brand-mark">安</span><span><strong>安心运</strong><small>ANXINYUN · SINGAPORE</small></span></a>
				<nav aria-label="Main navigation"><a href="#services" data-i18n="navServices">服务 Services</a><a href="#process" data-i18n="navProcess">流程 How it works</a><a href="#contact" data-i18n="navContact">联系 Contact</a></nav>
				<div class="header-tools"><a class="header-call" href="tel:+6586879666">+65 8687 9666</a><button class="language-toggle" type="button" aria-label="Switch language"><span class="active">中</span><span>EN</span></button></div>
			</header>

			<main id="top">
				<section class="hero">
					<div class="hero-copy"><p class="eyebrow"><span></span> LOCAL MOVERS · SINGAPORE</p><h1 data-i18n="heroTitle">搬得安心，<br /><em>住得开心。</em></h1><p class="hero-intro" data-i18n="heroIntro">从一个房间到整个办公室，安心运让每一次搬迁都更有秩序、更省心。</p><p class="hero-intro english" data-i18n="heroEnglish">From a single room to a full office, we move your world with care.</p><div class="hero-actions"><a class="button button-primary" href="https://wa.me/6586879666" target="_blank" rel="noreferrer" data-i18n="bookButton">WhatsApp 预约 <span>↗</span></a><a class="button button-ghost" href="#services" data-i18n="servicesButton">查看服务 <span>↓</span></a></div><a class="hero-phone" href="tel:+6586879666"><span data-i18n="phoneLabel">电话咨询 / Call us</span><span class="whatsapp-mark" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2a8.7 8.7 0 0 0-7.5 13l-1 3.6 3.7-1a8.7 8.7 0 1 0 4.8-15.6Z"/><path d="M8.3 8.2c.2-.3.4-.3.7-.3h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.3.5 1.2 1.5 2.1 2 .3.2.5.2.7 0l.6-.7c.1-.2.3-.2.5-.1l1.5.7c.2.1.3.3.3.5-.1.7-.5 1.2-1 1.4-.5.2-1.2.1-2-.2-2.6-1-4.4-3.7-4.5-3.9-.2-.3-1.1-1.8-.1-3.1Z"/></svg></span><strong>+65 8687 9666</strong></a><div class="hero-note"><span class="status-dot"></span><span data-i18n="availability">现在联系我们 · Available for bookings</span></div></div>
					<div class="hero-art" aria-label="明亮舒适的住宅客厅" role="img"><img src="/hero-moving.jpg" alt="明亮舒适的住宅客厅" /><div class="hero-art-overlay"></div><div class="art-caption"><b>SG</b><span data-i18n="artCaption">搬家，从容一点</span></div></div>
				</section>

				<section class="trust-bar" aria-label="服务特点"><div><b>01</b><span data-i18n="trustOne">准时可靠<br /><small>On time, every time</small></span></div><div><b>02</b><span data-i18n="trustTwo">细心搬运<br /><small>Handled with care</small></span></div><div><b>03</b><span data-i18n="trustThree">价格透明<br /><small>Clear, honest pricing</small></span></div></section>

				<section class="section services" id="services"><div class="section-heading"><p class="eyebrow">WHAT WE DO / 我们的服务</p><h2 data-i18n="servicesTitle">把搬家的麻烦，<br /><span>交给我们。</span></h2></div><div class="service-grid"><article class="service-card featured"><div class="service-image"><img src="/home-moving.jpg" alt="纸箱与居家搬家场景" /></div><div class="service-content"><span class="card-number">01</span><h3 data-i18n="homeMoving">住宅搬家</h3><p data-i18n="homeMovingText">公寓、组屋、排屋，大小家庭搬迁都能妥善安排。</p><small>Home moving</small></div></article><article class="service-card"><div class="service-image"><img src="/office-moving.jpg" alt="明亮办公室工作空间" /></div><div class="service-content"><span class="card-number">02</span><h3 data-i18n="officeMoving">办公室搬迁</h3><p data-i18n="officeMovingText">减少停工时间，帮你有条不紊地搬到新办公室。</p><small>Office relocation</small></div></article><article class="service-card"><div class="service-image"><img src="/furniture-moving.jpg" alt="现代客厅家具" /></div><div class="service-content"><span class="card-number">03</span><h3 data-i18n="furnitureMoving">家具运输</h3><p data-i18n="furnitureMovingText">单件家具、网购大件或临时运输，灵活又方便。</p><small>Furniture delivery</small></div></article></div></section>

				<section class="section process" id="process"><div class="section-heading"><p class="eyebrow">SIMPLE STEPS / 简单三步</p><h2 data-i18n="processTitle">你只管期待<br /><span>新家的样子。</span></h2></div><div class="steps"><div><b>01</b><h3 data-i18n="stepOne">告诉我们需求</h3><p data-i18n="stepOneText">发 WhatsApp，告诉我们搬运地址、日期和物品。</p></div><div><b>02</b><h3 data-i18n="stepTwo">确认透明报价</h3><p data-i18n="stepTwoText">我们快速了解情况，给你清晰的搬运方案。</p></div><div><b>03</b><h3 data-i18n="stepThree">安心交给我们</h3><p data-i18n="stepThreeText">准时到达，细心搬运，让你轻松完成搬家。</p></div></div></section>

				<section class="contact-section" id="contact"><div><p class="eyebrow">LET'S GET MOVING / 开始搬家</p><h2 data-i18n="contactTitle">准备好<br /><em>轻松搬家了吗？</em></h2><p data-i18n="contactText">告诉我们你的计划，我们会尽快回复。</p></div><div class="contact-details"><a class="contact-link" href="https://wa.me/6586879666" target="_blank" rel="noreferrer"><span>WhatsApp</span><strong>+65 8687 9666 <span class="whatsapp-mark" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2a8.7 8.7 0 0 0-7.5 13l-1 3.6 3.7-1a8.7 8.7 0 1 0 4.8-15.6Z"/><path d="M8.3 8.2c.2-.3.4-.3.7-.3h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.1-.1.3 0 .5.3.5 1.2 1.5 2.1 2 .3.2.5.2.7 0l.6-.7c.1-.2.3-.2.5-.1l1.5.7c.2.1.3.3.3.5-.1.7-.5 1.2-1 1.4-.5.2-1.2.1-2-.2-2.6-1-4.4-3.7-4.5-3.9-.2-.3-1.1-1.8-.1-3.1Z"/></svg></span></strong></a><div class="contact-row"><span data-i18n="contactPerson">联系人 / Contact</span><b>Mr Sui</b></div><div class="contact-row"><span data-i18n="contactAddress">地址 / Address</span><b>3018 Bedok North Street 5<br />#04-39, Singapore 486132</b></div></div></section>
			</main>

			<footer><span>© {new Date().getFullYear()} 安心运 Anxinyun</span><span>Made for moving days in Singapore</span></footer>
			<script>
				const translations = {
					en: {
						navServices: 'Services', navProcess: 'How it works', navContact: 'Contact', artCaption: 'Move with ease',
						heroTitle: 'Move with care,<br /><em>live with ease.</em>', heroIntro: 'From a single room to a full office, Anxinyun makes every move organised and stress-free.', heroEnglish: 'Trusted local movers for homes, offices and furniture in Singapore.', bookButton: 'Book on WhatsApp <span>↗</span>', servicesButton: 'Our services <span>↓</span>', phoneLabel: 'Call us', availability: 'Now taking bookings · Available for bookings',
						trustOne: 'Reliable timing<br /><small>On time, every time</small>', trustTwo: 'Handled with care<br /><small>Every item matters</small>', trustThree: 'Clear pricing<br /><small>Simple, honest quotes</small>', servicesTitle: 'Leave the moving<br /><span>to us.</span>', homeMoving: 'Home moving', homeMovingText: 'Apartments, HDB flats and landed homes, handled with care.', officeMoving: 'Office relocation', officeMovingText: 'Move to your new workspace with less downtime and more order.', furnitureMoving: 'Furniture delivery', furnitureMovingText: 'Single items, bulky purchases or flexible transport, made easy.', processTitle: 'You look forward to<br /><span>your new place.</span>', stepOne: 'Tell us what you need', stepOneText: 'Message us on WhatsApp with your addresses, date and items.', stepTwo: 'Confirm your quote', stepTwoText: 'We understand the job and provide a clear moving plan.', stepThree: 'Leave it to us', stepThreeText: 'We arrive on time and move everything with care.', contactTitle: 'Ready for a<br /><em>stress-free move?</em>', contactText: 'Tell us about your plans and we will get back to you shortly.', contactPerson: 'Contact person', contactAddress: 'Address'
					},
					zh: { navServices: '服务 Services', navProcess: '流程 How it works', navContact: '联系 Contact', artCaption: '搬家，从容一点', heroTitle: '搬得安心，<br /><em>住得开心。</em>', heroIntro: '从一个房间到整个办公室，安心运让每一次搬迁都更有秩序、更省心。', heroEnglish: 'From a single room to a full office, we move your world with care.', bookButton: 'WhatsApp 预约 <span>↗</span>', servicesButton: '查看服务 <span>↓</span>', phoneLabel: '电话咨询 / Call us', availability: '现在联系我们 · Available for bookings', trustOne: '准时可靠<br /><small>On time, every time</small>', trustTwo: '细心搬运<br /><small>Handled with care</small>', trustThree: '价格透明<br /><small>Clear, honest pricing</small>', servicesTitle: '把搬家的麻烦，<br /><span>交给我们。</span>', homeMoving: '住宅搬家', homeMovingText: '公寓、组屋、排屋，大小家庭搬迁都能妥善安排。', officeMoving: '办公室搬迁', officeMovingText: '减少停工时间，帮你有条不紊地搬到新办公室。', furnitureMoving: '家具运输', furnitureMovingText: '单件家具、网购大件或临时运输，灵活又方便。', processTitle: '你只管期待<br /><span>新家的样子。</span>', stepOne: '告诉我们需求', stepOneText: '发 WhatsApp，告诉我们搬运地址、日期和物品。', stepTwo: '确认透明报价', stepTwoText: '我们快速了解情况，给你清晰的搬运方案。', stepThree: '安心交给我们', stepThreeText: '准时到达，细心搬运，让你轻松完成搬家。', contactTitle: '准备好<br /><em>轻松搬家了吗？</em>', contactText: '告诉我们你的计划，我们会尽快回复。', contactPerson: '联系人 / Contact', contactAddress: '地址 / Address' }
				};
				const languageToggle = document.querySelector('.language-toggle');
				languageToggle?.addEventListener('click', () => { const language = document.documentElement.lang === 'zh-CN' ? 'en' : 'zh'; document.documentElement.lang = language === 'en' ? 'en' : 'zh-CN'; document.querySelectorAll('[data-i18n]').forEach((element) => { const value = translations[language][element.dataset.i18n]; if (value) element.innerHTML = value; }); languageToggle.querySelectorAll('span').forEach((item, index) => item.classList.toggle('active', (language === 'zh' && index === 0) || (language === 'en' && index === 1))); });
			</script>
	</body>
</html>
